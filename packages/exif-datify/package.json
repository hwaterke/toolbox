{
  "name": "exif-datify",
  "description": "CLI to rename files with date and time information from Exif data",
  "version": "0.0.10",
  "author": "Harold Waterkeyn",
  "license": "MIT",
  "repository": "hwaterke/exif-datify",
  "homepage": "https://github.com/hwaterke/exif-datify",
  "bugs": "https://github.com/hwaterke/exif-datify/issues",
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "exif-datify": "./bin/run.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "oclif": {
    "bin": "exif-datify",
    "dirname": "exif-datify",
    "commands": "./src/commands",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hwaterke/file-utils": "workspace:*",
    "@hwaterke/media-probe": "workspace:*",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5",
    "luxon": "^3"
  },
  "devDependencies": {
    "@types/luxon": "^3",
    "@types/node": "^24",
    "eslint": "^8",
    "eslint-config-oclif": "^6",
    "eslint-config-oclif-typescript": "^3",
    "eslint-config-prettier": "^10",
    "prettier": "^3"
  }
}
