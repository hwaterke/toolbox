{
  "name": "exif-datify",
  "description": "CLI to rename files with date and time information from Exif data",
  "version": "0.0.10",
  "author": "Harold Waterkeyn",
  "license": "MIT",
  "repository": "hwaterke/exif-datify",
  "homepage": "https://github.com/hwaterke/exif-datify",
  "bugs": "https://github.com/hwaterke/exif-datify/issues",
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "exif-datify": "./bin/run.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "oclif": {
    "bin": "exif-datify",
    "dirname": "exif-datify",
    "commands": "./src/commands",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hwaterke/file-utils": "workspace:*",
    "@hwaterke/media-probe": "workspace:*",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "chalk": "^5",
    "temporal-polyfill": "catalog:"
  }
}
