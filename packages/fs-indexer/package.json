{
  "name": "fs-indexer",
  "version": "0.0.7",
  "author": "hwaterke @hwaterke",
  "repository": "hwaterke/fs-indexer",
  "homepage": "https://github.com/hwaterke/fs-indexer",
  "license": "MIT",
  "type": "module",
  "exports": "./src/index.ts",
  "bin": {
    "fs-indexer": "./bin/run.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "oclif": {
    "bin": "fs-indexer",
    "dirname": "fs-indexer",
    "commands": "./src/commands",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:drop": "drizzle-kit drop",
    "test": "vitest run"
  },
  "dependencies": {
    "@hwaterke/file-utils": "workspace:*",
    "@hwaterke/media-probe": "workspace:*",
    "@libsql/client": "^0.15.10",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@paralleldrive/cuid2": "^2.2.2",
    "drizzle-orm": "^0.44.4",
    "ignore": "^7.0.5",
    "ora": "^8.2.0",
    "remeda": "^2.30.0",
    "winston": "^3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@oclif/test": "^5.0.0",
    "drizzle-kit": "^0.31.4"
  }
}
