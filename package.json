{
  "name": "fs-indexer",
  "version": "0.0.7",
  "author": "hwaterke @hwaterke",
  "repository": "hwaterke/fs-indexer",
  "homepage": "https://github.com/hwaterke/fs-indexer",
  "license": "MIT",
  "type": "module",
  "exports": "./lib/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fs-indexer": "./bin/run.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "oclif": {
    "bin": "fs-indexer",
    "dirname": "fs-indexer",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "postbuild": "shx cp -r src/drizzle/migrations dist/drizzle",
    "lint": "eslint . --ext .ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "format": "prettier --write .",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:drop": "drizzle-kit drop",
    "test": "mocha --require tsx 'test/**/*.test.ts'",
    "test:watch": "mocha --require tsx --watch --watch-files src/,test/ 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@hwaterke/media-probe": "npm:@jsr/hwaterke__media-probe@^0.0.12",
    "@libsql/client": "^0.14.0",
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@paralleldrive/cuid2": "^2.2.2",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.38.1",
    "ignore": "^7.0.5",
    "luxon": "^3",
    "remeda": "^2.23.0",
    "winston": "^3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.0",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/better-sqlite3": "^7.6.10",
    "@types/chai": "^5",
    "@types/luxon": "^3",
    "@types/mocha": "^10",
    "@types/node": "^22",
    "chai": "^5.2.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-oclif-typescript": "^3",
    "eslint-config-prettier": "^10",
    "mocha": "^10",
    "oclif": "^4",
    "prettier": "^3",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.20.2",
    "typescript": "^5"
  }
}
